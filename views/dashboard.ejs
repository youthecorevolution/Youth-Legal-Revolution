<%- include('partials/head',{title,description:'Secure Youth Legal Revolution content dashboard.',canonical,schemaJson:null,noindex:true}) %>
<main><section class="section admin-shell"><div class="section-inner"><div class="admin-top"><div><p class="section-kicker">YLR · Editorial dashboard</p><h1>Manage site content</h1><p>Signed in as <%= admin.email %>. Unpublished content is visible only to editors.</p></div><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn-outline" type="submit">Sign out</button></form></div>
  <div class="admin-grid"><section class="admin-panel"><div class="admin-panel-head"><h2>Articles</h2><a class="btn-dark" href="/admin/articles/new">New article</a></div>
    <% if (articles.length) { %><div class="admin-list"><% articles.forEach((item)=>{ %><div class="admin-row"><div><strong><%= item.title %></strong><span><%= item.status %> · updated <%= new Date(item.updated_at).toLocaleDateString('en-IN') %></span></div><a href="/admin/articles/<%= item.id %>/edit">Edit</a><form method="post" action="/admin/articles/<%= item.id %>/delete" onsubmit="return confirm('Delete this article?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Delete</button></form></div><% }); %></div><% } else { %><p>No articles yet.</p><% } %>
  </section>
  <section class="admin-panel"><div class="admin-panel-head"><h2>Legislation reviews</h2><a class="btn-dark" href="/admin/reviews/new">New review</a></div>
    <% if (reviews.length) { %><div class="admin-list"><% reviews.forEach((item)=>{ %><div class="admin-row"><div><strong><%= item.title %></strong><span><%= item.status %> · updated <%= new Date(item.updated_at).toLocaleDateString('en-IN') %></span></div><a href="/admin/reviews/<%= item.id %>/edit">Edit</a><form method="post" action="/admin/reviews/<%= item.id %>/delete" onsubmit="return confirm('Delete this review?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Delete</button></form></div><% }); %></div><% } else { %><p>No reviews yet.</p><% } %>
  </section></div>
  <div class="disclaimer"><strong>Publication standard:</strong> Reviews need a pinpoint legal citation, dated evidence and source links. Separate what the law requires from evidence about actual performance. Publish only after editorial review.</div>
</div></section></main>
<%- include('partials/footer') %>
