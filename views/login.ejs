<%- include('partials/head',{title,description:'Private editorial dashboard sign in.',canonical,schemaJson:null,noindex:true}) %>
<main><section class="section admin-shell"><div class="admin-panel narrow"><p class="section-kicker">YLR · Editorial access</p><h1>Admin sign in</h1><p>Sign in to manage articles and source-based legislation reviews.</p>
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email<input type="email" name="email" autocomplete="username" required maxlength="254"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="200"></label><button class="btn-dark" type="submit">Sign in</button></form>
  <p class="small-copy">Admin access is private. Do not share your login or password.</p></div></section></main>
<%- include('partials/footer') %>
